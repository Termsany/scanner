DATABASE_URL=sqlite+aiosqlite:///./alpha_scanner.db
# DATABASE_URL=postgresql+asyncpg://alpha:alpha@localhost:5432/alpha
REDIS_URL=
SCAN_INTERVAL_SECONDS=60
CHAINS=["solana","ethereum","base","bsc"]
MIN_LIQUIDITY_USD=10000
MIN_VOLUME_1H_USD=5000
LIVE_SIGNAL_MIN_SCORE=75
GOPLUS_ACCESS_TOKEN=
RUGCHECK_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SCORE=80
TELEGRAM_COMMANDS_ENABLED=true
PUBLIC_DASHBOARD_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
RUN_SCANNER_IN_API=false
# Gemini instead of OpenAI:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.5-flash
# NVIDIA NIM (reasoning models: disable thinking or replies can take minutes):
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_EXTRA_BODY={"chat_template_kwargs": {"enable_thinking": false}}
LLM_MAX_TOKENS=600
# Birdeye (free "Standard" key from https://bds.birdeye.so): profitable-trader discovery for smart wallets.
# Budget-limited to BIRDEYE_DAILY_CALL_BUDGET calls / 24h (default 30 = ~900/month, under the free 1,000).
BIRDEYE_API_KEY=
